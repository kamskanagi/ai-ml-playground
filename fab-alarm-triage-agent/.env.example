# --- LLM ---
# Get one at https://console.groq.com/keys — never commit the real value.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Database ---
POSTGRES_USER=fab
# Local development only. Override in any deployed environment.
POSTGRES_PASSWORD=fab
POSTGRES_DB=fab_mes
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Host-side port mapping for docker compose (container port stays 5432).
POSTGRES_HOST_PORT=5433

# --- Services ---
BACKEND_URL=http://backend:8000
MCP_URL=http://mcp:9000/mcp

# --- Agent ---
MAX_TOOL_CALLS=12
STRUCTURED_OUTPUT_RETRIES=2

# --- Seeding ---
SEED_DEMO=42
SEED_EVAL=1337

# --- Optional tracing ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
